    "loam-theme"
  ],
  "files": [
    {
      "path": "registry/loam/ui/divider.tsx",
      "content": "import * as React from 'react'\nimport { clsx } from 'clsx'\nconst Divider=({label,className,...props}:React.HTMLAttributes<HTMLDivElement>&{label?:string})=><div role=\"separator\" className={clsx('flex items-center gap-3 text-[var(--loam-ink-soft)]',className)} {...props}><span className=\"h-px flex-1 bg-[var(--loam-line)]\"/>{label&&<span className=\"font-mono text-[9px] uppercase tracking-[.16em]\">{label}</span>}<span className=\"h-px flex-1 bg-[var(--loam-line)]\"/></div>\nexport { Divider }\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}